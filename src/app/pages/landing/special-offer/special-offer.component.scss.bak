.section-title {
    margin-bottom: 60px;
    text-align: center;
    
    .sub-title {
        background-color: transparent;
        color: var(--mainColor, #0A66C2);
        padding: 6px 0;
        display: block;
        margin-bottom: 5px;
        font-weight: 500;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        text-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    
    h2 {
        color: var(--secondaryColor);
        font-size: 38px;
        margin-bottom: 0;
    }
}

.glossy-section {
    text-align: center;
    margin-bottom: 50px;
    
    .sub-title {
        background-color: transparent;
        color: var(--mainColor, #0A66C2);
        padding: 6px 0;
        display: block;
        margin-bottom: 5px;
        font-weight: 500;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        text-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    
    .title-container {
        position: relative;
        display: inline-block;
        
        h2 {
            color: var(--secondaryColor);
            font-size: 38px;
            margin-bottom: 0;
        }
        
        .title-underline {
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--mainColor), transparent);
        }
    }
}

@media (max-width: 991px) {
    .row.align-items-stretch {
        .col-lg-6:last-child {
            margin-top: 30px;
        }
    }
}

@media (max-width: 767px) {
    .offer-content, .premium-upgrade-card {
        padding: 25px;
        
        h2 {
            font-size: 28px;
        }
    }
    
    .section-title h2,
    .glossy-section .title-container h2 {
        font-size: 28px;
    }
}

