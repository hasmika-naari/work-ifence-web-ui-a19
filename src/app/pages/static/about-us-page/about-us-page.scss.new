:host {
  font-family: 'Poppins', sans-serif;
}

:host .mat-icon {
  font-family: 'Material Icons' !important;
}

// Modern Title Section
.modern-title-section {
  position: relative;
  padding: 0 0 30px 0;
  z-index: 10;
  margin-bottom: 20px;
  
  .title-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }
  
  .navigation-buttons {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 6px;
  }
  
  .nav-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--mainColor, #4353ff);
    font-weight: 500;
    font-size: 15px;
    line-height: 1;
    text-decoration: none;
    transition: all 0.2s ease;
    padding: 4px 0;
    
    lucide-icon {
      width: 18px;
      height: 18px;
      stroke-width: 2px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: -1px; /* Fine-tune vertical alignment */
    }
    
    &:hover {
      color: var(--secondaryColor, #2d3bda);
    }
  }
  
  .home-button {
    &:after {
      content: '|';
      margin-left: 16px;
      color: rgba(var(--mainColor-rgb, 67, 83, 255), 0.3);
      font-weight: 300;
      display: inline-flex;
      align-items: center;
      height: 100%;
      line-height: 1;
      position: relative;
      top: -1px; /* Fine-tune vertical alignment */
    }
  }
  
  .back-button {
    &:hover {
      transform: translateX(-3px);
    }
  }
  
  .about-us-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 15px 0 0 0;
    color: var(--mainColor, #242d60);
  }
  
  // Add a gradient effect for the title in dark mode
  .dark-about-us-area .about-us-title {
    background: linear-gradient(90deg, var(--mainColor), var(--secondaryColor));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

@media (max-width: 576px) {
  .dark-about-us-area .about-us-title {
    background-size: 100% 100%;
  }
}
}

// Responsive adjustments
@media (max-width: 768px) {
  .modern-title-section {
    padding: 0 0 20px 0;
    
    .about-us-title {
      font-size: 2rem;
    }
    
    .navigation-buttons {
      margin-bottom: 8px;
    }
    
    .nav-button {
      font-size: 14px;
      
      lucide-icon {
        width: 16px;
        height: 16px;
        margin-top: -1px;
      }
    }
  }
}

@media (max-width: 576px) {
  .modern-title-section {
    padding: 0 0 15px 0;
    
    .about-us-title {
      font-size: 1.8rem;
    }
    
    .nav-button {
      font-size: 13px;
      
      lucide-icon {
        width: 15px;
        height: 15px;
        margin-top: -1px;
      }
    }
    
    .home-button {
      &:after {
        margin-left: 12px;
      }
    }
  }
}

#errormask {
  position: absolute !important;
  left: 0px !important; 
  right: 0px !important;
  margin: auto !important;
  bottom: 0px !important;
  top: 0px !important;
  z-index: 60 !important;
  background-color: rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(2px);
}

.about-us-area {
  z-index: 70;
  position: relative;
  padding-top: 100px;
  padding-bottom: 0px;
  // Add margin for footer
  margin-bottom: 0px;
  background-color: #f8fafc;
  background-image:
    radial-gradient(circle at 15% 15%, hsla(10, 80%, 60%, 0.2), transparent 35%),
    radial-gradient(circle at 85% 25%, hsla(230, 80%, 70%, 0.2), transparent 35%),
    radial-gradient(circle at 70% 80%, hsla(330, 80%, 70%, 0.25), transparent 40%),
    radial-gradient(circle at 20% 75%, hsla(45, 100%, 60%, 0.15), transparent 40%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
  
  .container {
    // background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(5px);
    border-radius: 15px;
    // box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    padding: 30px;
  }
}

.about-us-area .story-content {
  margin-top: -6px;
  background-color: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 15px;
  box-shadow: 0 4px 16px rgba(31, 38, 135, 0.05);
  padding: 30px;
}

.about-us-area .story-content p {
  margin-bottom: 30px;
  color: var(--paragraphColor);
  line-height: 1.7;
}

.about-us-area .story-content p:last-child {
  margin-bottom: 0;
}

.about-us-area .story-content h4.title {
  margin-bottom: 20px;
  font-size: 22px;
  font-weight: 600;
  color: var(--secondaryColor);
  position: relative;
  padding-bottom: 10px;
}

.about-us-area .story-content h4.title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 50px;
  height: 2px;
  background: linear-gradient(90deg, var(--mainColor), var(--secondaryColor));
}

.about-us-area .story-content ul {
  margin-bottom: 30px;
  padding-left: 20px;
}

.about-us-area .story-content ul li {
  color: var(--paragraphColor);
  margin-bottom: 10px;
  position: relative;
  line-height: 1.7;
}

.about-us-area .story-content ul li::before {
  content: '•';
  color: var(--mainColor);
  font-weight: bold;
  display: inline-block;
  width: 1em;
  margin-left: -1em;
}

.about-us-area .story-content ul li:last-child {
  margin-bottom: 0;
}

.about-us-area.dark-about-us-area {
  background-color: #121212;
  background-image:
    radial-gradient(circle at 15% 15%, hsla(10, 80%, 40%, 0.15), transparent 35%),
    radial-gradient(circle at 85% 25%, hsla(230, 80%, 50%, 0.15), transparent 35%),
    radial-gradient(circle at 70% 80%, hsla(330, 80%, 50%, 0.2), transparent 40%),
    radial-gradient(circle at 20% 75%, hsla(45, 100%, 40%, 0.1), transparent 40%);
}

.about-us-area.dark-about-us-area .story-content {
  background-color: rgba(30, 30, 30, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.about-us-area.dark-about-us-area .story-content p {
  color: rgba(255, 255, 255, 0.87);
}

.about-us-area.dark-about-us-area .story-content h4.title {
  color: var(--mainColor);
}

.about-us-area.dark-about-us-area .story-content ul li {
  color: rgba(255, 255, 255, 0.87);
}

/* Responsive styles */
@media only screen and (max-width: 767px) {
  .about-us-area {
    overflow: hidden;
    padding-top: 70px;
    padding-bottom: 70px;
  }
  
  .about-us-area .story-content {
    margin-top: 0;
    padding: 20px;
    text-align: center;
  }
  
  .about-us-area .story-content h4.title {
    font-size: 18px;
    margin-bottom: 15px;
    padding-bottom: 8px;
  }
  
  .about-us-area .story-content p {
    font-size: 14px;
    margin-bottom: 20px;
  }
  
  .about-us-area .story-content ul li {
    font-size: 14px;
    margin-bottom: 8px;
    text-align: left;
  }

  .about-us-area .story-content h3 {
    margin-bottom: 10px;
    font-size: 18px;
  }
  
  .page-title-area {
    padding-top: 80px;
    padding-bottom: 40px;
  }
  
  .page-title-area .page-title-content h2 {
    font-size: 24px;
  }
  
  .page-title-area .page-title-content ul li {
    font-size: 14px;
  }
}

/* Vision section styling */
.vision-section {
  margin: 40px 0;
  padding: 0;
}

.vision-card {
  background-color: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.5);
  padding: 25px;
  height: 100%;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  text-align: center;
}

.vision-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.vision-icon {
  font-size: 48px;
  color: var(--mainColor);
  margin-bottom: 20px;
}

.vision-title {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 15px;
  color: var(--headingColor);
}

.vision-text {
  color: var(--paragraphColor);
  line-height: 1.6;
  margin-bottom: 0;
}

/* Dark mode for vision cards */
.dark-about-us-area .vision-card {
  background-color: rgba(40, 40, 40, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.dark-about-us-area .vision-title {
  color: rgba(255, 255, 255, 0.95);
}

.dark-about-us-area .vision-text {
  color: rgba(255, 255, 255, 0.7);
}

.dark-about-us-area .vision-icon {
  color: var(--mainColor);
}