// FAQ Data Model interfaces
export interface FAQ {
  id: number;
  question: string;
  answer: string;
  expanded: boolean;
}

export interface FAQSection {
  title: string;
  faqs: FAQ[];
}

@Component({
  selector: 'app-faq-list-page',
  standalone: true,
  imports: [CommonModule, RouterLink, LanguageSubscribeComponent,
      NgOptimizedImage, FooterWorkifenceComponent, HeaderWorkifenceComponent, IconsModule, MatExpansionModule],
