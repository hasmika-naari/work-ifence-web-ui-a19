}

::ng-deep.form-action-buttons{
  width: 100%;
  position: relative;
  bottom: 20px;
  right:10px;
  // margin-top: 25px;
  text-align: right;
  margin: 10px;
  margin-right: 0px;

  .p-button.p-button-sm{
    border-radius: 16px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: var(--secondaryColor) !important;
    color: white !important; 
  }

  .p-button.p-button-sm:hover{
    background-color: var(--mainColor) !important;
    color: white !important; 
  }

}


.justify-content-end{
  justify-content: end;
}

i{
  margin-right: 5px;
}

.template{
  width: fit-content;
  float: right;
  img{
    width: 300px;
    height: auto;
    object-fit: contain;
  }
}

.mt-30{
  margin-top: 30px;
}

.mb-0{
  margin-bottom: 0;
}

.grid-templates-columns-auto-auto{
  display: grid;
  grid-template-columns: auto auto auto auto;
}

.fit-content{
  width: fit-content;
}

/* Style for the textarea */
textarea {
  height: 150px;
  resize:vertical; /* Prevent resizing */
  font-size: 14px;
  display: block;
  color: black;
  outline: none;
  margin: 0;
  box-shadow: none;
  transition: border 150ms ease;
  width: 100%;
  background: white;
  padding: 0.85em 0.75em 0.75em;
  border: 2px solid #f0f0f0;
  border-radius: 0.25em;
}

/* Style for the textarea when focused */
textarea:focus {
  border-color: black; /* Change border color when focused */
}

/* Style for placeholder text */
textarea::placeholder {
  color: #999; /* Placeholder text color */
}

/* Style for disabled textarea */
textarea:disabled {
  background-color: #f2f2f2; /* Light gray background */
  cursor: not-allowed; /* Change cursor when disabled */
}

.prl-0{
  padding-left: 0;
  padding-right: 0;
}

.grid-templates-columns-auto-auto-auto{
  display: grid;
  grid-template-columns: auto auto auto;
}

.br-1{
  border-right: 1px solid #ccc;

}

.stepper {
  position: relative;
  margin: 50px 0px 0px 50px;
}

.step {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.circle {
  width: 30px;
  height: 30px;
  background-color: #fff;
  color: #007bff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
  margin-right: 20px;
  cursor: pointer;
  transition: background-color 0.3s, color 0.3s;
  border: 1px solid #007bff;
}

.circle:hover, .circle.completed:hover {
  background-color: #f05b4e;
  color: #fff;
  border: 1px solid #f05b4e;
}

.circle-selected {
  background-color: #f05b4e;
  color: #fff;
}

.circle-skipped{
  background-color: gray !important;
  border: 1px solid gray !important;
  color: #fff;
}

.circle-completed::after {
  content: '\2713'; /* Checkmark icon */
  color: white !important;
}

.step-name {
  font-size: 16px;
  font-weight: bold;
}

.line {
  width: 2px;
  background-color: #007bff;
  position: absolute;
  top: 15px;
  bottom: 50px; /* Height of the circle */
  left: calc(50% - 1px); /* Position it between circles */
  z-index: -1;
}

.line:not(:last-child) {
  height: calc(90%); /* Extend line to bottom of next circle */
}

.justify-content-center{
  justify-content: center;
}

.align-items-center{
  align-items: center;
}

.display-flex{
  display: flex;
}

.card-container{
  padding: 2rem;
  overflow-y: auto; /* Enable vertical scrolling */
  box-sizing: border-box;
}

.card {
  width: 100%;
  background-color: #fff;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s;
  margin: 10px 0px;
  padding: 20px;
  box-sizing: border-box;
  position: relative;
  .select-btn{
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: none;
  }
  button{
    padding: 10px 20px;
    background-color: #f05b4e;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: bold;
    width: fit-content;
    margin-left: 10px;
    color: white;
    border: none;
  }
}

.card:hover{
  .select-btn{
    display: block;
  }
}

.card-focused{
  background-color: #f05b4e;
  color: white;
}

// .card:hover {
//   transform: translateY(-5px);
//   box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
// }

/* HTML: <div class="loader"></div> */
.loader {
  width: 15px;
  padding: 2px;
  aspect-ratio: 1;
  border-radius: 50%;
  background: #f05b4e;
  --_m: 
    conic-gradient(#0000 10%,#000),
    linear-gradient(#000 0 0) content-box;
  -webkit-mask: var(--_m);
          mask: var(--_m);
  -webkit-mask-composite: source-out;
          mask-composite: subtract;
  animation: l3 1s infinite linear;
}
@keyframes l3 {to{transform: rotate(1turn)}}

.custom-expansion-panel {
  border: 1px solid #ccc;
  border-radius: 4px;
}

.panel-header {
  display: flex;
  align-items: center;
  cursor: pointer;
  padding: 12px;
  border-bottom: 1px solid #ccc;
}

.panel-title {
  flex: 1;
}

.toggle-icon {
  transition: transform 0.3s;
}

.toggle-icon.expanded {
  transform: rotate(180deg);
}

.panel-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s;
}

.panel-content.expanded {
  max-height: 1000px; /* Adjust as needed */
}

.delete-btn{
  padding: 10px 20px;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: bold;
  margin-left: 10px;
  background-color: #EE4266;
  color: white;
  border: 1px solid #EE4266;
}

.skill-btn{
  padding: 10px 20px;
  background-color: white !important;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: bold;
  margin-left: 10px;
  color: #f05b4e !important;
  border: 1px solid #f05b4e !important;
}

.skill-btn:hover{
  background-color: #f05b4e !important;
  color: white !important;
}

.optimize-btn{
  padding: 10px 20px;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: bold;
  margin-left: 10px;
  background-color: white;
  color: #f05b4e;
  border: 1px solid #f05b4e !important;
}


// .footer {
//   position: fixed;
//   left: 5%;
//   bottom: 0;
//   width: 95%;
//   background-color: white; 
// }

.sheet {
  position: fixed;
  top: 0;
  right: -47%; /* Initially hidden off the screen */
  width: 47%;
  height: 100%;
  background-color: white;
  transition: right 0.5s ease; /* Smooth transition */
  box-shadow: -2px 0 5px rgba(0, 0, 0, 0.3); /* Optional: Add shadow */
  z-index: 999; /* Ensure it's above other content */
}

.sheet.open {
  right: 0; /* Slide in from the right */
}

.close {
  position: absolute;
  top: 10px;
  right: 10px;
  cursor: pointer;
  font-size: 24px;
  color: #999;
}

.close:hover {
  color: #333;
}

.flex-wrap{
  flex-wrap: wrap;
}

/* CSS */
.save-success-card {
  position: fixed;
  bottom: -100px; /* Initially hidden off the screen */
  right: 10px;
  width: 300px;
  padding: 20px;
  background-color: black; /* Changed to black */
  color: white; /* Text color */
  border-radius: 5px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
  transition: bottom 0.5s ease-in-out; /* Smooth transition */
  display: flex;
  justify-content: flex-start;
  font-size: 0.857rem;
}

.save-success-card.show {
  bottom: 20px; /* Bring it up to show */
}



/* Edit Theme */
.edit-theme {
  --edit-theme-color: #3498db; /* Main color for edit theme */
  --edit-theme-hover: #2980b9; /* Hover color for edit theme */
}

/* Danger Theme */
.danger-theme {
  --danger-theme-color: #e74c3c; /* Main color for danger theme */
  --danger-theme-hover: #c0392b; /* Hover color for danger theme */
}

/* Example Usage */
.button {
  padding: 10px 20px;
  border: none;
  border-radius: 5px;
  color: white;
  cursor: pointer;
}

/* Edit Theme Button */
.button.edit-theme {
  background-color: var(--edit-theme-color);
}

.button.edit-theme:hover {
  background-color: var(--edit-theme-hover);
}

/* Danger Theme Button */
.button.danger-theme {
  background-color: var(--danger-theme-color);
}

.button.danger-theme:hover {
  background-color: var(--danger-theme-hover);
}

.exp-card {
  border-radius: 10px !important;
  // box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
  transition: 0.3s;
  margin: 0.5rem 0;
  width:100%;
}

/* styles.css or component-specific CSS file */
.enabled-button {
  background-color: #f05b4e;
  color: white;
  border: 1px solid #f05b4e;
  font-size: 0.8rem;
}

.disabled-button {
  background-color: #f5a39d;
  color: white;
  border: 1px solid #f5a39d;
  font-size: 0.8rem;
}

/* Clean professional responsive and component styles */
@media (max-width: 768px) {
  .metadata-form {
    padding: 1rem;
  }

  .metadata-simple {
    padding: 1.5rem;
  }

  .metadata-simple__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .metadata-simple__sync.p-button {
    align-self: stretch;
    justify-content: center;
  }

  .metadata-simple__grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .form-section--primary,
  .form-section--secondary {
    padding: 1rem;
  }
}

@media (max-width: 480px) {
  .metadata-simple {
    padding: 1rem;
  }

  .form-section--primary,
  .form-section--secondary {
    padding: 0.75rem;
  }

  .simple-field input[pInputText] {
    height: 2.5rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
  }
}

::ng-deep {
  .simple-field__control {
    width: 100%;
    display: flex;
    align-items: stretch;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(203, 213, 225, 0.8);
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .simple-field__control:hover {
    border-color: rgba(148, 163, 184, 0.9);
    background: rgba(255, 255, 255, 0.95);
  }

  .simple-field__control.p-inputwrapper-focus,
  .simple-field__control.p-dropdown-open,
  .simple-field__control.p-autocomplete-panel-visible {
    border-color: var(--mainColor, #f05b45);
    background: rgba(255, 255, 255, 1);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
  }

  .simple-field__control .p-inputtext,
  .simple-field__control .p-dropdown-label,
  .simple-field__control .p-dropdown .p-inputtext {
    width: 100%;
    border: none;
    background: transparent;
    height: 2.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #111827;
    font-weight: 500;
  }

  .simple-field__control .p-inputtext::placeholder {
    color: #9ca3af;
    font-weight: 400;
  }

  .simple-field__control .p-autocomplete-dropdown,
  .simple-field__control .p-dropdown-trigger {
    width: 2.75rem;
    min-width: 2.75rem;
    border: none;
    border-left: 1px solid rgba(226, 232, 240, 0.8);
    background: linear-gradient(135deg, 
      rgba(248, 250, 252, 0.8) 0%, 
      rgba(241, 245, 249, 0.9) 100%);
    color: #64748b;
    transition: all 0.3s ease;
    border-radius: 0 8px 8px 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .simple-field__control .p-autocomplete-dropdown:hover,
  .simple-field__control .p-dropdown-trigger:hover {
    background: linear-gradient(135deg, 
      rgba(240, 91, 69, 0.1) 0%, 
      rgba(240, 91, 69, 0.05) 100%);
    color: var(--mainColor, #f05b45);
    border-left-color: rgba(240, 91, 69, 0.3);
  }

  .cdk-overlay-pane .metadata-panel.p-component,
  .cdk-overlay-pane > .metadata-panel.p-component,
  .cdk-overlay-pane .p-autocomplete-panel.metadata-panel,
  .cdk-overlay-pane .p-dropdown-panel.metadata-panel {
    margin-top: 2px;
    border: 1px solid var(--mainColor, #f05b45);
    border-top: 1px solid rgba(240, 91, 69, 0.6);
    border-radius: 0 0 8px 8px;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .metadata-panel .p-autocomplete-item,
  .metadata-panel .p-dropdown-item {
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    transition: all 0.2s ease;
    border-bottom: 1px solid rgba(241, 245, 249, 0.6);
  }

  .metadata-panel .p-autocomplete-item:last-child,
  .metadata-panel .p-dropdown-item:last-child {
    border-bottom: none;
  }

  .metadata-panel .p-autocomplete-item.p-highlight,
  .metadata-panel .p-dropdown-item.p-highlight,
  .metadata-panel .p-autocomplete-item:hover,
  .metadata-panel .p-dropdown-item:hover {
    background: linear-gradient(135deg, 
      rgba(240, 91, 69, 0.08) 0%, 
      rgba(240, 91, 69, 0.12) 100%);
    color: var(--mainColor, #f05b45);
    font-weight: 600;
    transform: translateX(4px);
  }
}
