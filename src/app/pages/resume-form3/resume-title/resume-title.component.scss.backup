@import '../shared-form-styles';

:host {
  display: block;
}

::ng-deep {
  .p-drawer .p-drawer-header,
  .p-drawer-left .p-drawer-header,
  .p-sidebar .p-drawer-header,
  .p-sidebar-left .p-drawer-header {
    background: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom: none !important;
    padding: 1.5rem !important;
    border: none !important;
  }
}

.metadata-form {
  padding: 2rem;
  background: transparent;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.metadata-simple {
  width: 100%;
  max-width: 800px;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 12px;
  border: 1px solid rgba(226, 232, 240, 0.7);
  backdrop-filter: blur(10px);
  overflow: hidden;
}

.metadata-simple__header {
  padding: 2rem 2rem 1.5rem;
  border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 2rem;

  h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
    font-weight: 600;
    color: #1e293b;
  }

  p {
    margin: 0;
    font-size: 0.875rem;
    color: #64748b;
  }
}

.save-button {
  background: var(--mainColor, #f05b45) !important;
  color: white !important;
  border: none !important;
  border-radius: 6px !important;
  padding: 0.75rem 1.5rem !important;
  font-weight: 500 !important;
  transition: background-color 0.2s ease !important;

  &:hover {
    background: #e04936 !important;
  }

  &:disabled {
    background: #cbd5e1 !important;
    color: #94a3b8 !important;
  }
}

.form-content {
  padding: 2rem;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;

  &--full {
    grid-column: 1 / -1;
  }

  label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    margin-bottom: 0.25rem;

    .required {
      color: var(--mainColor, #f05b45);
      margin-left: 0.25rem;
    }
  }

  input[pInputText] {
    height: 2.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.875rem;
    background: white;
    color: #111827;
    transition: border-color 0.15s ease;

    &:focus {
      outline: none;
      border-color: var(--mainColor, #f05b45);
    }

    &::placeholder {
      color: #9ca3af;
    }
  }

  .error {
    font-size: 0.75rem;
    color: var(--mainColor, #f05b45);
    margin-top: 0.25rem;
  }
}

.checkbox-section {
  display: flex;
  gap: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(226, 232, 240, 0.5);
}

.checkbox-group {
  display: flex;
  align-items: center;

  mat-checkbox {
    font-size: 0.875rem;
    color: #374151;
  }
}

// Global styles for PrimeNG components
::ng-deep {
  .field-control {
    width: 100%;
    
    .p-inputtext, .p-dropdown-label {
      height: 2.5rem;
      padding: 0.75rem 1rem;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 0.875rem;
      background: white;
      color: #111827;
      transition: border-color 0.15s ease;
    }

    .p-inputtext:focus, &.p-focus .p-inputtext {
      border-color: var(--mainColor, #f05b45);
      outline: none;
    }

    .p-dropdown-trigger {
      background: transparent;
      border: none;
      border-left: 1px solid #e5e7eb;
      color: #6b7280;
      width: 2.5rem;
    }

    .p-autocomplete-dropdown {
      background: transparent;
      border: none;
      border-left: 1px solid #e5e7eb;
      color: #6b7280;
      width: 2.5rem;
    }

    &.p-dropdown-open .p-inputtext,
    &.p-autocomplete-panel-visible .p-inputtext {
      border-color: var(--mainColor, #f05b45);
    }
  }

  .dropdown-panel {
    border: 1px solid var(--mainColor, #f05b45);
    border-radius: 6px;
    background: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);

    .p-autocomplete-item, .p-dropdown-item {
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      color: #374151;
      transition: background-color 0.15s ease;

      &:hover, &.p-highlight {
        background: rgba(240, 91, 69, 0.1);
        color: var(--mainColor, #f05b45);
      }
    }
  }
}

@media (max-width: 768px) {
  .metadata-form {
    padding: 1rem;
  }

  .metadata-simple__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .form-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .checkbox-section {
    flex-direction: column;
    gap: 1rem;
  }

  .form-content {
    padding: 1.5rem;
  }
}
    background: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom: none !important;
    padding: 1.5rem !important;
    border: none !important;
  }

  .p-drawer .p-drawer-content {
    /* background: rgba(255, 255, 255, 0.85); */
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-radius: 0;
}
}

.metadata-form {
  padding: clamp(1.5rem, 3vw, 2.5rem);
  background: transparent;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.metadata-simple {
  width: min(100%, 900px);
  display: flex;
  flex-direction: column;
  gap: clamp(1.5rem, 3vw, 2rem);
  padding: clamp(2rem, 4vw, 3rem);
  border-radius: 12px;
  background: transparent;
  border: none;
  backdrop-filter: blur(12px);
}

.metadata-simple__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: clamp(1.5rem, 4vw, 2rem);
  padding-bottom: clamp(1rem, 2vw, 1.5rem);
  border-bottom: 2px solid var(--mainColor, #f05b45);
  background-color: transparent !important;
}

.metadata-simple__header h2 {
  margin: 0;
  font-size: clamp(1.5rem, 3vw, 1.75rem);
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.025em;
}

.metadata-simple__sync.p-button {
  border-radius: 8px;
  font-weight: 600;
  color: #0f172a;
  padding: 0.75rem 1.5rem;
  background: transparent;
  border: 2px solid var(--mainColor, #f05b45);
  transition: all 0.2s ease;
}

.metadata-simple__sync.p-button:enabled:hover {
  color: #ffffff;
  background: var(--mainColor, #f05b45);
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-section--primary {
  padding: 1.5rem;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(226, 232, 240, 0.6);
  border-radius: 8px;
  backdrop-filter: blur(8px);
}

.form-section--secondary {
  padding: 1.5rem;
  background: rgba(248, 250, 252, 0.6);
  border: 1px solid rgba(226, 232, 240, 0.6);
  border-radius: 8px;
  backdrop-filter: blur(8px);
}

.section-title {
  margin: 0 0 1.25rem 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: #334155;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.metadata-simple__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.simple-field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.simple-field--full {
  grid-column: 1 / -1;
}

.simple-field label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.25rem;
}

.simple-field label .required {
  color: var(--mainColor, #f05b45);
  margin-left: 0.125rem;
}

.simple-field input[pInputText] {
  border: 1px solid #d1d5db;
  border-radius: 6px;
  height: 2.75rem;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  background: #ffffff;
  color: #111827;
  transition: border-color 0.2s ease;
}

.simple-field input[pInputText]:focus {
  outline: none;
  border-color: var(--mainColor, #f05b45);
}

.simple-field input[pInputText]::placeholder {
  color: #9ca3af;
}

.hint-text {
  font-size: 0.75rem;
  color: #6b7280;
  margin-top: 0.25rem;
  line-height: 1.4;
}

.simple-field .error {
  margin-top: 0.25rem;
  font-size: 0.75rem;
  color: var(--mainColor, #f05b45);
  font-weight: 500;
}

.metadata-simple__toggle-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}

.toggle-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.toggle-hint {
  font-size: 0.75rem;
  color: #6b7280;
  margin-left: 2rem;
  line-height: 1.4;
}

mat-checkbox {
  font-size: 0.875rem;
  font-weight: 500;
  color: #374151;
}

mat-checkbox:hover {
  color: var(--mainColor, #f05b45);
}

.metadata-simple__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: clamp(1.5rem, 3vw, 2rem);
}

.simple-field {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: clamp(1.2rem, 2.5vw, 1.5rem);
  background: linear-gradient(145deg, 
    rgba(255, 255, 255, 0.9) 0%, 
    rgba(248, 250, 252, 0.8) 100%);
  border: 1px solid rgba(240, 91, 69, 0.06);
  border-radius: 18px;
  min-width: 0;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.simple-field::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    var(--mainColor, #f05b45) 50%, 
    transparent 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.simple-field:hover {
  border-color: rgba(240, 91, 69, 0.12);
  box-shadow: 
    0 16px 40px -12px rgba(15, 23, 42, 0.06),
    0 4px 20px -4px rgba(240, 91, 69, 0.08);
  transform: translateY(-2px);
}

.simple-field:hover::before {
  opacity: 1;
}

.simple-field:focus-within {
  border-color: rgba(240, 91, 69, 0.2);
  box-shadow: 
    0 20px 48px -12px rgba(15, 23, 42, 0.08),
    0 8px 24px -4px rgba(240, 91, 69, 0.12),
    0 0 0 3px rgba(240, 91, 69, 0.08);
  transform: translateY(-3px);
}

.simple-field:focus-within::before {
  opacity: 1;
}

.simple-field--full {
  grid-column: 1 / -1;
}

.simple-field label {
  font-size: 0.95rem;
  font-weight: 700;
  color: rgba(15, 23, 42, 0.92);
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.simple-field label .required {
  color: var(--mainColor, #f05b45);
  font-size: 1.1em;
}

.simple-field input[pInputText] {
  border: none;
  border-radius: 14px;
  height: 3rem;
  padding: 0.8rem 1.2rem;
  font-size: 0.96rem;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.95);
  color: rgba(15, 23, 42, 0.9);
  box-shadow: 
    inset 0 0 0 1px rgba(240, 91, 69, 0.08),
    0 2px 8px -2px rgba(15, 23, 42, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.simple-field input[pInputText]:focus {
  outline: none;
  background: rgba(255, 255, 255, 1);
  box-shadow: 
    inset 0 0 0 2px rgba(240, 91, 69, 0.2),
    0 4px 16px -4px rgba(240, 91, 69, 0.12);
  transform: translateY(-1px);
}

.simple-field input[pInputText]::placeholder {
  color: rgba(100, 116, 139, 0.7);
  font-weight: 400;
}

.hint-text {
  font-size: 0.84rem;
  color: rgba(100, 116, 139, 0.85);
  margin-top: 0.2rem;
  font-weight: 500;
  line-height: 1.4;
}

.simple-field .error {
  margin-top: 0.3rem;
  font-size: 0.8rem;
  color: var(--mainColor, #f05b45) !important;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.simple-field .error::before {
  content: '⚠';
  font-size: 0.9em;
}

.metadata-simple__toggles {
  border-top: 1px solid rgba(240, 91, 69, 0.08);
  padding-top: clamp(1.5rem, 3vw, 2rem);
  display: flex;
  flex-direction: column;
  gap: clamp(1.2rem, 2.5vw, 1.6rem);
  background: linear-gradient(145deg, 
    rgba(240, 91, 69, 0.01) 0%, 
    rgba(248, 250, 252, 0.3) 100%);
  border-radius: 20px;
  padding: clamp(1.5rem, 3vw, 2rem);
  margin-top: 1rem;
  position: relative;
  overflow: hidden;
}

.metadata-simple__toggles::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(240, 91, 69, 0.2) 20%, 
    rgba(240, 91, 69, 0.3) 50%, 
    rgba(240, 91, 69, 0.2) 80%, 
    transparent 100%);
}

.metadata-simple__toggles h3 {
  margin: 0;
  font-size: clamp(1.05rem, 2.2vw, 1.25rem);
  font-weight: 700;
  color: rgba(15, 23, 42, 0.9);
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.metadata-simple__toggles h3::before {
  content: '⚙️';
  font-size: 1.1em;
}

.metadata-simple__toggle-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: clamp(1rem, 2.5vw, 1.5rem);
  align-items: start;
}

.toggle-hint {
  margin: 0.2rem 0 0.8rem 2.4rem;
  font-size: 0.85rem;
  color: rgba(100, 116, 139, 0.8);
  font-weight: 500;
  line-height: 1.4;
}

mat-checkbox {
  font-size: 0.98rem;
  font-weight: 600;
  color: rgba(15, 23, 42, 0.9);
  transition: all 0.3s ease;
  padding: 0.4rem 0;
}

mat-checkbox:hover {
  color: var(--mainColor, #f05b45);
}

mat-checkbox .mdc-checkbox {
  border-radius: 8px;
}

@media (max-width: 700px) {
  .metadata-form {
    padding: clamp(1rem, 4vw, 1.5rem);
  }

  .metadata-simple {
    padding: clamp(1.5rem, 6vw, 2rem);
    gap: clamp(1.5rem, 4vw, 2rem);
  }

  .metadata-simple__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .metadata-simple__sync.p-button {
    align-self: stretch;
    justify-content: center;
  }

  .metadata-simple__grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .simple-field {
    padding: 1rem 1.2rem;
  }

  .metadata-simple__toggles {
    padding: 1.2rem;
    margin-top: 0.5rem;
  }

  .metadata-simple__toggle-list {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

@media (max-width: 520px) {
  .metadata-form {
    padding: 0.75rem;
  }

  .metadata-simple {
    border-radius: 18px;
    padding: 1.25rem;
  }

  .simple-field {
    padding: 0.9rem;
    border-radius: 14px;
  }

  .simple-field input[pInputText] {
    height: 2.75rem;
    padding: 0.7rem 1rem;
    font-size: 0.94rem;
  }

  .metadata-simple__toggles {
    border-radius: 16px;
    padding: 1rem;
  }
}

@media (max-width: 380px) {
  .metadata-simple__header h2 {
    font-size: 1.3rem;
  }

  .simple-field label {
    font-size: 0.9rem;
  }

  .hint-text {
    font-size: 0.8rem;
  }

  .toggle-hint {
    font-size: 0.8rem;
    margin-left: 2rem;
  }
}

::ng-deep {
  .simple-field__control {
    width: 100%;
    display: flex;
    align-items: stretch;
    border-radius: 16px;
    background: linear-gradient(145deg, 
      rgba(255, 255, 255, 0.98) 0%, 
      rgba(248, 250, 252, 0.92) 100%);
    border: 1px solid rgba(240, 91, 69, 0.08);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    overflow: hidden;
    box-shadow: 
      0 2px 12px -4px rgba(15, 23, 42, 0.04),
      0 0 0 1px rgba(255, 255, 255, 0.8);
  }

  .simple-field__control::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(145deg, 
      rgba(240, 91, 69, 0.02) 0%, 
      transparent 50%, 
      rgba(240, 91, 69, 0.01) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .simple-field__control:hover {
    border-color: rgba(240, 91, 69, 0.15);
    box-shadow: 
      0 4px 20px -6px rgba(15, 23, 42, 0.06),
      0 2px 12px -2px rgba(240, 91, 69, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.9);
    transform: translateY(-1px);
  }

  .simple-field__control:hover::before {
    opacity: 1;
  }

  /* Aggressive targeting for active states */
  .simple-field__control.p-inputwrapper-focus,
  .simple-field__control.p-dropdown-open,
  .simple-field__control.p-autocomplete-panel-visible,
  .simple-field__control:has(.p-autocomplete-panel),
  .simple-field__control:has(.p-dropdown-panel) {
    border-color: rgba(240, 91, 69, 0.25) !important;
    box-shadow: 
      0 8px 32px -8px rgba(15, 23, 42, 0.08) !important,
      0 4px 20px -4px rgba(240, 91, 69, 0.15) !important,
      0 0 0 3px rgba(240, 91, 69, 0.08) !important;
    border-bottom-left-radius: 8px !important;
    border-bottom-right-radius: 8px !important;
    border-bottom: 1px solid rgba(240, 91, 69, 0.25) !important;
    position: relative !important;
    z-index: 999 !important;
    transform: translateY(-2px) !important;
  }

  .simple-field__control.p-inputwrapper-focus::before,
  .simple-field__control.p-dropdown-open::before,
  .simple-field__control.p-autocomplete-panel-visible::before {
    opacity: 1;
  }

  /* Additional state targeting */
  .simple-field__control.p-focus,
  .simple-field__control[aria-expanded="true"] {
    border-color: rgba(240, 91, 69, 0.25) !important;
    border-bottom-left-radius: 8px !important;
    border-bottom-right-radius: 8px !important;
  }

  .simple-field__control .p-inputtext,
  .simple-field__control .p-dropdown-label,
  .simple-field__control .p-dropdown .p-inputtext {
    width: 100%;
    border: none;
    background: transparent;
    height: 3rem;
    padding: 0.8rem 1.2rem;
    font-size: 0.96rem;
    font-weight: 500;
    color: rgba(15, 23, 42, 0.9);
    box-shadow: none;
    transition: all 0.3s ease;
  }

  .simple-field__control .p-inputtext::placeholder {
    color: rgba(100, 116, 139, 0.65);
    font-weight: 400;
  }

  .simple-field__control .p-autocomplete-dropdown,
  .simple-field__control .p-dropdown-trigger {
    width: 3rem;
    min-width: 3rem;
    border: none;
    border-left: 1px solid rgba(240, 91, 69, 0.08);
    background: linear-gradient(145deg, 
      rgba(240, 91, 69, 0.02) 0%, 
      transparent 100%);
    color: rgba(240, 91, 69, 0.7);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0 16px 16px 0;
  }

  .simple-field__control .p-autocomplete-dropdown:hover,
  .simple-field__control .p-dropdown-trigger:hover {
    background: rgba(240, 91, 69, 0.06);
    color: var(--mainColor, #f05b45);
  }

  /* Modern overlay panel styling */
  .cdk-overlay-pane .metadata-panel.p-component,
  .cdk-overlay-pane > .metadata-panel.p-component,
  .cdk-overlay-pane .p-autocomplete-panel.metadata-panel,
  .cdk-overlay-pane .p-dropdown-panel.metadata-panel {
    margin-top: 0 !important;
    box-shadow: 
      0 24px 64px -12px rgba(15, 23, 42, 0.15) !important,
      0 8px 32px -8px rgba(240, 91, 69, 0.12) !important,
      0 0 0 1px rgba(240, 91, 69, 0.08) !important;
    border: 1px solid rgba(240, 91, 69, 0.12) !important;
    border-top: 1px solid rgba(240, 91, 69, 0.08) !important;
    border-radius: 8px 8px 18px 18px !important;
    border-top-left-radius: 8px !important;
    border-top-right-radius: 8px !important;
    box-sizing: border-box !important;
    background: linear-gradient(145deg, 
      rgba(255, 255, 255, 0.98) 0%, 
      rgba(248, 250, 252, 0.95) 100%) !important;
    backdrop-filter: blur(20px) !important;
    position: relative !important;
    z-index: 1000 !important;
    transform: translateY(-3px) !important;
    overflow: hidden !important;
  }

  .metadata-panel.p-component {
    --overlaySurfaceBorder: 1px solid rgba(240, 91, 69, 0.12);
    --overlaySurfaceShadow: 0 24px 64px -12px rgba(15, 23, 42, 0.15);
  }

  .metadata-panel .p-autocomplete-item,
  .metadata-panel .p-dropdown-item {
    padding: 0.85rem 1.2rem;
    font-weight: 500;
    color: rgba(15, 23, 42, 0.88);
    transition: all 0.2s ease;
    border-radius: 10px;
    margin: 0.2rem 0.5rem;
  }

  .metadata-panel .p-autocomplete-item.p-highlight,
  .metadata-panel .p-dropdown-item.p-highlight,
  .metadata-panel .p-autocomplete-item:hover,
  .metadata-panel .p-dropdown-item:hover {
    background: linear-gradient(135deg, 
      rgba(240, 91, 69, 0.08) 0%, 
      rgba(240, 91, 69, 0.12) 100%);
    color: var(--mainColor, #f05b45);
    font-weight: 600;
    transform: translateX(4px);
  }
}


.field {
  background: rgba(248, 250, 252, 0.6);
  padding: 1rem 1.1rem;
  border-radius: 1rem;
  border: 1px solid transparent;
  box-shadow: inset 0 0 0 1px rgba(226, 232, 240, 0.8);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
  min-width: 0;
  width: 100%;
}

.field:focus-within {
  border-color: rgba(240, 91, 69, 0.55);
  box-shadow: 0 12px 34px -28px rgba(240, 91, 69, 0.6);
}

.field label {
  font-size: 0.92rem;
  font-weight: 600;
  color: rgba(15, 23, 42, 0.86);
}

.field label .required {
  color: #f05b45;
}

.field--plain {
  background: transparent;
  padding: 0;
  border-radius: 0;
  box-shadow: none;
  border: none;
  gap: 0.5rem;
}

.field--plain input {
  border: 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.45);
  border-radius: 0;
  padding: 0.5rem 0;
  background: transparent;
  font-size: 1.05rem;
  font-weight: 500;
  color: rgba(15, 23, 42, 0.82);
}

.field--plain input:focus {
  outline: none;
  box-shadow: none;
  border-bottom-color: rgba(240, 91, 69, 0.8);
}

.field--plain input::placeholder {
  color: rgba(100, 116, 139, 0.6);
  font-weight: 400;
}

.hint-text {
  display: block;
  margin-top: 0.15rem;
  font-size: 0.82rem;
  color: rgba(100, 116, 139, 0.9);
}

.field .error {
  margin-top: 0.4rem;
  padding: 0;
  font-size: 0.78rem;
  color: var(--mainColor, #f05b45) !important;
  font-weight: 500;
  background: none !important;
  letter-spacing: 0.01em;
}

@media (max-width: 900px) {
  .metadata-grid,
  .toggle-grid {
    grid-template-columns: 1fr;
  }

  .metadata-card__footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .metadata-card__title {
    align-items: flex-start;
  }
}

@media (max-width: 600px) {
  .metadata-form {
    padding: 1rem;
  }

  .metadata-card__icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }
}


:host {
  font-family: 'Poppins', sans-serif;
}

/* Force font on all elements within this component */
// :host * {
//   font-family: 'Poppins', sans-serif;
// }

:host{
  .mat-icon{
      font-family: 'Material Icons' !important;
  }

}

.container{
  min-height: 100vh;
  margin: 0;
  min-width: 100%;
  color: black !important;
}

@keyframes animateGradient {
  0% {
    background-position: 0 50%;
}
50% {
    background-position: 100% 40%; /* Move the gradient to the right */
}
100% {
    background-position: 0 50%; /* Return to the starting position */
}
}

.animated-box {
  // background-image: linear-gradient(45deg, #ff7e5f, #feb47b, #ffcf66, #f3ff5f, #5de4ff, #a683eb, #ff7e5f);
  // background-size: 200% 200%; /* Make the gradient larger than the element */
  // animation: animateGradient 10s linear infinite; /* Animation duration: 10s, linear timing, infinite loop */
  background-image: linear-gradient(45deg, #f05b45, #f8c7c0);
  background-size: 200% 200%;
  animation: animateGradient 5s linear infinite;
}

.column{
  display:flex;
  flex-direction: column;
}
.justify-content-start{
  justify-content: start;
}
.page-info{
  padding: 20px;
  button{
    border: 0;
    color:#f05b4e;
    background-color: transparent;
