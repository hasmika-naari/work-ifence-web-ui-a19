{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "./dist/server",
    "target": "es2022",
    "module": "es2022",                        
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "files": [
    "server.ts",                               
    "src/main.server.ts",
    "src/polyfills.server.ts"                       
  ],
  "angularCompilerOptions": {
    "entryModule": "./src/app/app.server.module#AppServerModule"
  }
}
